\section*{SECTION B}

\begin{enumerate}
  \item In Figure 2.1, a triangle ABC is drawn to circumscribe a circle of radius 3 cm, such that the segments BD and DC are respectively of lengths 6 cm and 9 cm. If the area of \( \triangle ABC = 54 \text{cm}^2 \), find the lengths of sides AB and AC.

  \begin{center}
    \includegraphics[width=0.85\columnwidth]{Figure2_1.png}
    \captionof{figure}{Figure 2.1}
  \end{center}

  \item Solve the quadratic equation for \( x \): \( 4x^2 + 4bx - (a^2 - b^2) = 0 \)

  \item In an AP, if \( S5 + S7 = 167 \) and \( S{10} = 235 \), then find the AP, where \( Sn \) denotes the sum of the first \( n \) terms.

  \item The points \( A = (4, 7) \), \( B = (p, 3) \), and \( C = (7, 3) \) are vertices of a right triangle, right-angled at B. Find the value of \( p \).

  \item Find the relation between \( x \) and \( y \) if the points \( A = (x, y) \), \( B = (-5, 7) \), and \( C = (-4, 5) \) are collinear.
\end{enumerate}

\section*{SECTION C}

\begin{enumerate}
  \item The 14th term of an AP is twice its 8th term. If its 6th term is -8, then find the sum of the first 20 terms.
\end{enumerate}
